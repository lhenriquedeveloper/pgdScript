# ==========================================
# Configurações do Script PGD (AtendeMais & GitLab)
# ==========================================

# --- GLPI (AtendeMais UFT) ---
# URL base da API REST do GLPI
GLPI_BASE_URL="https://sistemas.uft.edu.br/atendemais/apirest.php"

# Token Pessoal gerado no GLPI em: Preferências do Usuário > Tokens de API
GLPI_USER_TOKEN="seu_user_token_aqui"

# App-Token gerado pelo Administrador da API no GLPI (deixe em branco se não for exigido)
GLPI_APP_TOKEN=""

# ID numérico ou login do usuário no GLPI (opcional - detectado automaticamente se omitido)
GLPI_USER_ID=""

# --- GitLab Institucional (git.uft.edu.br) ---
# URL base da API v4 do GitLab
GITLAB_BASE_URL="https://git.uft.edu.br/api/v4"

# Personal Access Token gerado em: User Settings > Access Tokens (escopo: read_api)
GITLAB_TOKEN="seu_personal_access_token_aqui"

# Seu nome de usuário no GitLab UFT
GITLAB_USER="seu_username_uft"

# --- Opções do Relatório PGD ---
# Dias retroativos padrão para o relatório (ex: 7 para a última semana)
DEFAULT_DAYS=7

# Formato padrão de saída: 'markdown' ou 'plain'
DEFAULT_FORMAT="markdown"

# Caminho para arquivo de mapeamento de metas personalizado (opcional)
GOALS_MAPPING_FILE="config/goals_mapping.json"
